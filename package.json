{
  "name": "gpt-obsidian-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx apps/collector/src/index.ts",
    "start": "node dist/collector.js",
    "build": "tsc --noEmit && tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "mcp": "node dist/mcp-server.js",
    "sync": "tsx scripts/admin.ts sync",
    "integrate": "tsx scripts/integrate.ts",
    "admin": "tsx scripts/admin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^17.2.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/chrome": "^0.1.30",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "@types/jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.0",
    "playwright": "^1.56.0"
  }
}
